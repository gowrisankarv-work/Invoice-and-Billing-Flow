# Copy to .env to override local Docker Compose credentials.
MONGO_ROOT_USERNAME=invoiceflow
MONGO_ROOT_PASSWORD=invoiceflow
MINIO_ACCESS_KEY=invoiceflow
MINIO_SECRET_KEY=invoiceflow-secret
MINIO_BUCKET=invoiceflow-documents
# Container image for MinIO (also provides the mc client used to create the bucket).
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
